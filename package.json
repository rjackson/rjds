{
  "name": "@rjackson/rjds",
  "version": "0.5.0-4",
  "description": "My own personal design system: React components styled with Tailwind CSS",
  "license": "MIT",
  "author": "Rob Jackson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rjackson/rjds.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "size": "npm run build && size-limit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.1.0 || ^18.0.2",
    "tailwindcss": "^3.0.24"
  },
  "husky": {
    "hooks": {
      "pre-commit": "tsdx lint"
    }
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "10 KB"
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "husky": "^7.0.4",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "size-limit": "^12.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
